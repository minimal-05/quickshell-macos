#!/bin/bash
# Open the file manager, or focus it if it is already open.
#
# A standalone quickshell process (an ApplicationWindow in finder.qml), not a
# panel inside the running shell. A process owning no panel stays a regular macOS
# app, which is what gives this a Dock icon and a Spotlight entry.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The checkout: two levels up from src/tools, four from inside the bundle.
ROOT="${HERE%/Quickshell.app/Contents/Resources/tools}"; ROOT="${ROOT%/src/tools}"

# qs-make-app's own copy of the engine inside Files.app, not the shared one in
# Quickshell.app. macOS resolves a running process's identity (name, bundle id
# -- everything yabai's window rules and Accessibility key off) from the bundle
# the actual running Mach-O lives inside, walking up from its real path. Every
# one of these standalone configs execing into Quickshell.app's own binary
# meant every one of their windows reported that same identity, so a rule meant
# for one (the picker, Settings) caught this one's plain windows too, and yabai
# could not act on any of them at all: role and subrole came back empty, and
# even a direct `yabai -m window <id> --toggle float` failed outright. This
# script still lives inside Quickshell.app's own bundle (that is what dispatches
# by name to it) so it cannot derive Files.app's location relative to itself;
# it is qs-make-app's fixed install path instead.
QS="$HOME/Applications/Files.app/Contents/MacOS/quickshell-engine"
# The config: ~/.config/quickshell/<QS_CONFIG_NAME>/ where that directory
# exists, else ~/.config/quickshell itself -- the flat layout darwin-dotfiles
# keeps, and what quickshell's own "default" resolves to.
CFG_DIR="$HOME/.config/quickshell"
[ -d "$CFG_DIR/${QS_CONFIG_NAME:-end4}" ] && CFG_DIR="$CFG_DIR/${QS_CONFIG_NAME:-end4}"
CONFIG="${QS_FINDER_CONFIG:-$CFG_DIR/finder.qml}"

# Files can have more than one window open (Cmd+N). Native Cmd+Q asks every
# top-level window to close, not just the one in front, which reads as
# "closing one Files window closes all of them" -- correct for the
# single-window configs (settings, welcome) but not this one. Read by
# CocoaPlugin::init() in src/cocoa/init.cpp, which strips Cmd+Q's key
# equivalent when this is set; Cmd+W (already wired per-window) is the only
# way to close a window either way.
export QS_MULTI_WINDOW_APP=1

# --hidden: start the process without showing a window. The login agent uses this
# so that the first time you actually open Files, the process is already warm --
# a cold start spends ~1.5s in Qt engine and scene graph setup no matter what.
#
# --pick-wallpaper <dark|light>: show the window in "choose a wallpaper" mode,
# which switchwall.sh uses in place of a native open panel.
START_HIDDEN=0
PICK_MODE=""
case "${1:-}" in
    --hidden)         START_HIDDEN=1 ;;
    --pick-wallpaper) PICK_MODE="${2:-dark}" ;;
esac

# PATH, XDG_RUNTIME_DIR and QML2_IMPORT_PATH are the binary's own doing.

# The wallpaper picker is a dialog, not a tile: yabai leaves it alone and puts it
# above the window that asked for it, which is usually settings. Matched on the
# title the window is born with -- rules are read when a window is created, so
# the picker gets a window of its own rather than borrowing a plain one.
# Labelled so repeated runs replace the rule instead of stacking copies.
if [ -n "$PICK_MODE" ]; then
    yabai -m rule --add label=quickshell-picker app="^(Files|quickshell)$" \
        title="^Choose a wallpaper$" manage=off sub-layer=above >/dev/null 2>&1 || true
fi

# Already open? Raise it rather than starting a second copy.
#
# Deliberately not `pgrep -f <config path>`: that matches *any* process whose
# command line happens to contain the path -- an editor, a grep, the shell that
# typed the command -- and a false positive here means the app silently refuses
# to start. Match on the process name -- quickshell-engine now that $QS is
# Files.app's own copy of the binary, not the shared one -- then confirm that
# specific process is running this config.
finder_running() {
    local pid
    for pid in $(pgrep -x quickshell-engine 2>/dev/null); do
        case "$(ps -o command= -p "$pid" 2>/dev/null)" in
            *"$CONFIG"*) return 0 ;;
        esac
    done
    return 1
}

# Launching Files while it is already running gets you another window, the way
# every other Mac app behaves -- not a jump back to the one that is open.
present() {
    if [ -n "$PICK_MODE" ]; then
        "$QS" -p "$CONFIG" ipc call finder pickWallpaper "$PICK_MODE" >/dev/null 2>&1
    else
        "$QS" -p "$CONFIG" ipc call finder newWindow >/dev/null 2>&1
    fi
}

if finder_running; then
    # Already warm. --hidden is only ever a boot-time prime, so do nothing.
    [ "$START_HIDDEN" = "1" ] && exit 0

    # Closing the window only hides it, so the running process may have nothing
    # on screen to focus -- ask it to show itself rather than hunting a window.
    present
    exit 0
fi

# Nothing was running a moment ago. Two invocations of this script can both
# reach this exact point before either one's process has registered with
# pgrep -- clicking the wallpaper picker button twice in quick succession did
# exactly that, and each copy independently decided "nothing is running yet,
# I will start one," opening two windows. A bare mkdir is atomic across
# processes sharing a filesystem, so only one caller can ever win it; every
# other caller waits for the winner's process to come up and joins it through
# the ordinary present() path instead of launching a second one of its own.
RUNTIME="${XDG_RUNTIME_DIR:-/tmp/quickshell-$UID}"
LOCK="$RUNTIME/quickshell-finder-launch.lock"
mkdir -p "$RUNTIME" 2>/dev/null

# A lock left behind by a launch that crashed or was killed before it could
# clean up after itself would otherwise wedge every future launch shut
# forever. Nothing this script does should take anywhere near this long, so
# a lock this old is abandoned, not held.
if [ -d "$LOCK" ]; then
    age=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || echo 0) ))
    [ "$age" -gt 15 ] && rmdir "$LOCK" 2>/dev/null
fi

if mkdir "$LOCK" 2>/dev/null; then
    [ "$START_HIDDEN" = "1" ] && export QS_FINDER_START_HIDDEN=1

    # Picking needs a message delivered *after* the window exists, so this is
    # the one path that cannot just exec: start the app, then keep offering
    # the message until the IPC socket answers. A cold start is ~1.5s of Qt
    # setup.
    # ponytail: a poll, because quickshell has nothing to wait on. The login
    # agent primes the process at boot, so the warm path above is the usual one.
    if [ -n "$PICK_MODE" ]; then
        # Hidden, so the pick lands in the warm window rather than beside a
        # plain one nobody asked for.
        QS_FINDER_START_HIDDEN=1 "$QS" -p "$CONFIG" &
        for _ in $(seq 1 40); do
            sleep 0.25
            if present; then
                rmdir "$LOCK" 2>/dev/null
                exit 0
            fi
        done
        rmdir "$LOCK" 2>/dev/null
        exit 1
    fi

    rmdir "$LOCK" 2>/dev/null
    exec "$QS" -p "$CONFIG"
fi

# Someone else holds the lock and is already launching. Wait for their process
# to actually exist, then reach it the normal warm way.
for _ in $(seq 1 40); do
    if finder_running; then
        present
        exit 0
    fi
    sleep 0.25
done
echo "qs-finder: timed out waiting for another launch to finish" >&2
exit 1

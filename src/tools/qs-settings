#!/bin/bash
# Open end-4's settings window, or focus it if it is already open.
#
# Settings is a standalone quickshell process (an ApplicationWindow in
# settings.qml), not a panel inside the running shell — that is how end-4 does it
# on Linux too.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
CONFIG="${QS_SETTINGS_CONFIG:-$HOME/.config/quickshell/${QS_CONFIG_NAME:-end4}/settings.qml}"

# skhd and launchd hand down a minimal PATH (launchctl getenv PATH is empty), so
# without this the shell cannot find yabai, jq, media-control or SwitchAudioSource.
# $ROOT/bin first: it carries our notify-send / xdg-open / pidof / qs stand-ins,
# which end-4 shells out to by bare name. Keeping them here rather than
# symlinked into /opt/homebrew means nothing is installed system-wide.
export PATH="$ROOT/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/quickshell-$UID}"
mkdir -p "$XDG_RUNTIME_DIR"
export QML2_IMPORT_PATH="$ROOT/shims${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"

# The settings window is a dialog, not a tile. Labelled so repeated runs replace
# the rule instead of stacking copies.
yabai -m rule --add label=quickshell app="^quickshell$" manage=off >/dev/null 2>&1 || true

# Already open? Raise it rather than starting a second copy.
#
# Short, specific pattern on purpose: macOS pgrep -f silently truncates long
# patterns, so a full command line here can match the wrong process.
if pgrep -f "end4-ii/settings.qml" >/dev/null 2>&1; then
    yabai -m query --windows 2>/dev/null \
        | jq -r '.[] | select(.title | test("Settings")) | .id' 2>/dev/null \
        | head -1 \
        | xargs -I{} yabai -m window --focus {} 2>/dev/null
    exit 0
fi

exec "$ROOT/bin/qs" -p "$CONFIG"

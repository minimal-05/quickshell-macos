#!/bin/bash
# Generate the Spotlight-launchable wrappers around the standalone quickshell
# apps: ~/Applications/Files.app (bin/qs-finder) and ~/Applications/Settings.app
# (bin/qs-settings).
#
#   qs-make-app             build both
#   qs-make-app Settings    build one
#
# The bundles are generated rather than committed because their launchers have to
# name this repo by absolute path -- same reason karabiner.json and skhdrc do.
# Moving the repo means running this again.
#
# They also exist for the dock: yabai reports both apps as "quickshell", so the
# dock cannot tell one from the other and pins them by name instead. The pin
# needs an app with that name and an icon, which is this.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The checkout, whether this ran from src/tools or from inside the bundle. A
# plain "$HERE/.." is wrong from the bundle: it lands on Contents/Resources, and
# the launcher below then pointed at Resources/bin/qs-finder, which does not
# exist -- Files.app opened nothing at all. Same two strips as qs-bundle.
ROOT="${HERE%/Quickshell.app/Contents/Resources/tools}"; ROOT="${ROOT%/src/tools}"

# name      launcher      warm-start at login?
APPS="Files:qs-finder:1
Settings:qs-settings:0"

make_app() {
    local name="$1" tool="$2" warm="$3"
    local id="org.quickshell.$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    local app="$HOME/Applications/$name.app"

    rm -rf "$app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

    cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>$name</string>
    <key>CFBundleDisplayName</key><string>$name</string>
    <key>CFBundleIdentifier</key><string>$id</string>
    <key>CFBundleExecutable</key><string>$name</string>
    <key>CFBundleIconFile</key><string>$name</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSMinimumSystemVersion</key><string>12.0</string>
</dict>
</plist>
PLIST

    # exec, not a plain call: the bundle's process becomes quickshell, so the app
    # stays alive as long as the window does instead of exiting immediately and
    # leaving an orphan behind it.
    cat > "$app/Contents/MacOS/$name" <<LAUNCHER
#!/bin/bash
exec "$ROOT/bin/$tool" "\$@"
LAUNCHER
    chmod +x "$app/Contents/MacOS/$name"

    [ -f "$ROOT/assets/$name.icns" ] && cp "$ROOT/assets/$name.icns" "$app/Contents/Resources/$name.icns"

    # Ad-hoc sign the bundle. Nothing here is distributed, but an unsigned bundle
    # is a coin flip on Apple Silicon and this repo already re-signs after every
    # copy.
    codesign -f -s - "$app" >/dev/null 2>&1 || true

    # LaunchServices caches bundles by path; without this a regenerated app can
    # keep answering Spotlight with the previous copy's metadata.
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "$app" >/dev/null 2>&1 || true
    touch "$app"

    echo "built $app"
    [ "$warm" = 1 ] && make_agent "$name" "$id" "$app"
    return 0
}

# Login agent. Opening Files means starting a Qt process, and ~1.5s of that is
# engine and scene graph setup that cannot be optimised away -- so start it once
# at login with no window, and every real open is a warm show() instead. Settings
# is opened rarely enough not to be worth a resident process.
make_agent() {
    local name="$1" id="$2" app="$3"
    local agent="$HOME/Library/LaunchAgents/$id.plist"
    mkdir -p "$(dirname "$agent")"
    cat > "$agent" <<AGENTPLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$id</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>-W</string>
        <string>-a</string>
        <string>$app</string>
        <string>--args</string>
        <string>--hidden</string>
    </array>
    <key>RunAtLoad</key><true/>
    <!-- -W above makes open(1) block until the app exits, so this job's lifetime
         tracks the real process and KeepAlive can do its job. Without it launchd
         sees open(1) return immediately and relaunches forever.

         KeepAlive matters because the process does die on its own: quickshell
         exits when the config tree it is rooted in changes, and ~/.config is a
         git repo that gets pulled into. Every death meant the next open paid a
         3s cold start. It comes back hidden, so a restart costs nothing visible. -->
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
AGENTPLIST

    launchctl bootout "gui/$UID/$id" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$UID" "$agent" >/dev/null 2>&1 || true
    echo "login agent: $agent  (remove with: launchctl bootout gui/$UID/$id && rm '$agent')"
}

want="${1:-}"
built=0
while IFS=: read -r name tool warm; do
    [ -n "$want" ] && [ "$want" != "$name" ] && continue
    make_app "$name" "$tool" "$warm"
    built=$((built + 1))
done <<< "$APPS"

if [ "$built" = 0 ]; then
    echo "qs-make-app: no such app '$want' (have: Files, Settings)" >&2
    exit 1
fi

# The launcher does not use Spotlight -- it finds apps through XDG desktop
# entries, which qs-index-apps generates from the Applications folders. Without
# this the apps are launchable from Spotlight but invisible to the shell's own
# search, which is the one actually bound to a key here.
"$HERE/qs-index-apps" >/dev/null 2>&1 || true

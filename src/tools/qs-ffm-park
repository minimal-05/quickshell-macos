#!/bin/bash
# Park yabai's focus_follows_mouse while a shell panel wants the keyboard.
#
# With focus_follows_mouse set, yabai focuses whatever window sits under the
# pointer. The overview covers the screen but yabai does not manage it, so the
# moment the panel appears yabai hands focus back to the window underneath and
# the search field stops receiving keys. Parking it for the duration is the only
# lever that does not require the window manager to know about shell surfaces.
#
#   qs-ffm-park park      remember the current setting, then turn it off
#   qs-ffm-park restore   put the remembered setting back
#
# ponytail: if the shell dies while parked, ffm stays off until the next park /
# restore cycle. Store it in a file rather than memory so a restart can recover.

set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

STATE="${XDG_RUNTIME_DIR:-/tmp/quickshell-$UID}/quickshell/ffm"
mkdir -p "$(dirname "$STATE")"

case "${1:-}" in
    park)
        # The state file existing IS the "already parked" flag, so a second park
        # can never overwrite the remembered value with our own setting. (yabai
        # reports "off" back as "disabled", so comparing values is not enough.)
        [ -e "$STATE" ] && exit 0
        current="$(yabai -m config focus_follows_mouse 2>/dev/null)"
        [ -n "$current" ] || exit 0
        printf '%s' "$current" > "$STATE"
        yabai -m config focus_follows_mouse off >/dev/null 2>&1
        ;;
    restore)
        [ -s "$STATE" ] || exit 0
        yabai -m config focus_follows_mouse "$(cat "$STATE")" >/dev/null 2>&1
        rm -f "$STATE"
        ;;
    *)
        echo "usage: qs-ffm-park park|restore" >&2
        exit 1
        ;;
esac

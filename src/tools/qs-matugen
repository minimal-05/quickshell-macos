#!/usr/bin/env python3
"""Generate end-4's colors.json on macOS — a stand-in for matugen.

matugen is a Rust CLI that isn't packaged for macOS. This produces the same
artifact using materialyoucolor, the Python port of Google's own
material-color-utilities, so the palette is generated by the real Material You
algorithm rather than an approximation.

  qs-matugen                          # seed from the current desktop wallpaper
  qs-matugen --image path/to/pic.jpg  # seed from an image
  qs-matugen --color '#8f7fd6'        # seed from an explicit colour
  qs-matugen --mode light             # default: dark
  qs-matugen --scheme expressive      # tonalspot (default), content, expressive,
                                      # fidelity, fruitsalad, monochrome, neutral,
                                      # rainbow, vibrant
"""

import argparse
import json
import os
import re
import subprocess
import tempfile
import sys
from pathlib import Path

STATE = Path.home() / "Library/Preferences/quickshell/State/user/generated"
OUT = STATE / "colors.json"

SCHEMES = {
    "tonalspot": "scheme_tonal_spot.SchemeTonalSpot",
    "content": "scheme_content.SchemeContent",
    "expressive": "scheme_expressive.SchemeExpressive",
    "fidelity": "scheme_fidelity.SchemeFidelity",
    "fruitsalad": "scheme_fruit_salad.SchemeFruitSalad",
    "monochrome": "scheme_monochrome.SchemeMonochrome",
    "neutral": "scheme_neutral.SchemeNeutral",
    "rainbow": "scheme_rainbow.SchemeRainbow",
    "vibrant": "scheme_vibrant.SchemeVibrant",
}


def snake(name: str) -> str:
    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()


def current_wallpaper() -> str | None:
    """Ask the window server what the desktop picture is."""
    try:
        out = subprocess.run(
            ["osascript", "-e", 'tell application "System Events" to get picture of current desktop'],
            capture_output=True, text=True, timeout=8,
        )
        path = out.stdout.strip()
        return path if path and os.path.isfile(path) else None
    except Exception:
        return None


def decodable(path: str) -> str:
    """Return a path Pillow can open, converting via sips if needed.

    macOS ships its wallpapers as .heic, which Pillow cannot read. sips is part
    of the base install and converts without any extra dependency.

    -Z caps the long edge during the same pass. Without it a stock 6016px
    desktop picture lands in /tmp as a ~50MB PNG, which is both slow and pure
    waste: the quantizer thumbnails to 128px regardless.
    """
    from PIL import Image

    try:
        Image.open(path).verify()
        return path
    except Exception:
        pass

    tmp = Path(tempfile.gettempdir()) / f"qs-matugen-{os.getpid()}.png"
    subprocess.run(
        ["sips", "-Z", "512", "-s", "format", "png", path, "--out", str(tmp)],
        capture_output=True, check=False, timeout=30,
    )
    if not tmp.exists():
        raise SystemExit(f"could not decode image: {path}")
    return str(tmp)


def seed_from_image(path: str) -> int:
    from materialyoucolor.quantize import QuantizeCelebi
    from materialyoucolor.score.score import Score
    from PIL import Image

    usable = decodable(path)
    try:
        image = Image.open(usable).convert("RGB")
        image.thumbnail((128, 128))
        # get_flattened_data() on new Pillow, getdata() on old; both give RGB triples.
        raw = image.get_flattened_data() if hasattr(image, "get_flattened_data") else image.getdata()
        pixels = [(r, g, b) for r, g, b in raw]
    finally:
        # A converted copy is scratch space, not a cache: leaving it behind grew
        # /tmp by one full-size PNG every time a .heic wallpaper was applied.
        if usable != path:
            try:
                os.unlink(usable)
            except OSError:
                pass
    result = QuantizeCelebi(pixels, 128)
    return Score.score(result)[0]


def seed_from_hex(value: str) -> int:
    value = value.lstrip("#")
    if len(value) != 6:
        raise SystemExit(f"not a #rrggbb colour: {value}")
    r, g, b = (int(value[i:i + 2], 16) for i in (0, 2, 4))
    return (255 << 24) | (r << 16) | (g << 8) | b


def to_hex(argb: int) -> str:
    return "#{:02x}{:02x}{:02x}".format((argb >> 16) & 0xFF, (argb >> 8) & 0xFF, argb & 0xFF)


def build(seed: int, dark: bool, scheme_name: str) -> dict:
    import importlib
    from materialyoucolor.hct import Hct
    from materialyoucolor.dynamiccolor.material_dynamic_colors import MaterialDynamicColors

    module_name, class_name = SCHEMES[scheme_name].rsplit(".", 1)
    module = importlib.import_module(f"materialyoucolor.scheme.{module_name}")
    scheme = getattr(module, class_name)(Hct.from_int(seed), dark, 0.0)

    colors = {}
    for name in dir(MaterialDynamicColors):
        member = getattr(MaterialDynamicColors, name)
        if not hasattr(member, "get_hct"):
            continue
        colors[snake(name)] = to_hex(member.get_hct(scheme).to_int())

    # end-4 also expects success tokens, which are not part of the M3 spec.
    # Derive them from a fixed green hue through the same scheme so they sit in
    # the palette rather than clashing with it.
    green = getattr(module, class_name)(Hct.from_hct(140.0, 40.0, Hct.from_int(seed).tone), dark, 0.0)
    for src, dst in (
        ("primary", "success"),
        ("onPrimary", "on_success"),
        ("primaryContainer", "success_container"),
        ("onPrimaryContainer", "on_success_container"),
    ):
        colors[dst] = to_hex(getattr(MaterialDynamicColors, src).get_hct(green).to_int())

    return colors


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--image")
    ap.add_argument("--color")
    ap.add_argument("--mode", choices=["dark", "light"], default="dark")
    ap.add_argument("--scheme", choices=sorted(SCHEMES), default="tonalspot")
    ap.add_argument("--out", default=str(OUT))
    args = ap.parse_args()

    if args.color:
        seed = seed_from_hex(args.color)
        source = f"colour {args.color}"
    else:
        image = args.image or current_wallpaper()
        if image:
            try:
                seed = seed_from_image(image)
                source = f"image {image}"
            except ImportError:
                print("Pillow is needed to seed from an image: pip3 install --user pillow", file=sys.stderr)
                return 2
        else:
            seed = seed_from_hex("#8f7fd6")
            source = "fallback colour"

    colors = build(seed, args.mode == "dark", args.scheme)

    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(colors, indent=2) + "\n")
    tmp.replace(out)   # atomic: the shell watches this file

    print(f"wrote {len(colors)} colours to {out} ({args.mode}, {args.scheme}, from {source})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/bin/bash
# Add (or remove) the shell's skhd bindings.
#
#   qs-install-keybinds           add the block to ~/.config/skhd/skhdrc
#   qs-install-keybinds --remove  take it back out
#
# end-4 binds these to SUPER on Linux through Hyprland's global-shortcut
# protocol. macOS has no equivalent, so they go through skhd and call the
# shell's IPC socket. ctrl+alt+cmd is used as the Super stand-in because that is
# the prefix the rest of your skhdrc already uses.
#
# Nothing here touches your existing bindings, and a backup is taken first.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RC="${SKHD_RC:-$HOME/.config/skhd/skhdrc}"
BEGIN="# --- quickshell bindings (managed by qs-install-keybinds) ---"
END="# --- end quickshell bindings ---"

[ -f "$RC" ] || { echo "no skhd config at $RC" >&2; exit 1; }

strip_block() {
    awk -v b="$BEGIN" -v e="$END" '
        $0 == b { skip = 1 }
        !skip   { print }
        $0 == e { skip = 0 }
    ' "$RC"
}

cp "$RC" "$RC.bak.$(date +%s)"

if [ "${1:-}" = "--remove" ]; then
    strip_block > "$RC.tmp" && mv "$RC.tmp" "$RC"
    echo "removed quickshell bindings from $RC"
else
    strip_block > "$RC.tmp"
    cat >> "$RC.tmp" <<EOF
$BEGIN
ctrl + alt + cmd - i        : $ROOT/bin/qs-settings
ctrl + alt + cmd - tab      : $ROOT/bin/qs-ipc search workspacesToggle
ctrl + alt + cmd - space    : $ROOT/bin/qs-ipc search toggle
cmd - space                 : $ROOT/bin/qs-ipc search toggle
ctrl + alt + cmd - a        : $ROOT/bin/qs-ipc sidebarLeft toggle
ctrl + alt + cmd - s        : $ROOT/bin/qs-ipc sidebarRight toggle
ctrl + alt + cmd - m        : $ROOT/bin/qs-ipc mediaControls toggle
ctrl + alt + cmd - j        : $ROOT/bin/qs-ipc bar toggle
ctrl + alt + cmd - k        : $ROOT/bin/qs-ipc osk toggle
ctrl + alt + cmd - p        : $ROOT/bin/qs-ipc wallpaperSelector toggle
ctrl + alt + cmd - e        : $ROOT/bin/qs-ipc session toggle
ctrl + alt + cmd - 0x2C     : $ROOT/bin/qs-ipc cheatsheet toggle
ctrl + alt + cmd - w        : $ROOT/bin/qs-ipc overlay toggle
ctrl + alt + cmd + shift - s: $ROOT/bin/qs-ipc region screenshot
$END
EOF
    mv "$RC.tmp" "$RC"
    echo "added quickshell bindings to $RC"
fi

if pgrep -x skhd >/dev/null 2>&1; then
    skhd --restart-service >/dev/null 2>&1 && echo "skhd reloaded"
    sleep 2
    LOG="/tmp/skhd_$USER.log"
    if [ -s "$LOG" ] && tail -5 "$LOG" | grep -q "error"; then
        echo "skhd reported a parse error — check $LOG" >&2
        exit 1
    fi
fi

#!/bin/bash
# Call an IPC target on the running shell.
#
#   qs-ipc bar toggle
#   qs-ipc sidebarLeft toggle
#   qs-ipc region screenshot
#
# On Linux these actions are bound through Hyprland's GlobalShortcut protocol.
# macOS has no equivalent, so skhd and karabiner call this instead — the shell
# exposes the same actions over its IPC socket either way. Both call it by
# absolute path, because Karabiner does not expand `~`; keep the name.
#
# The env and the config this targets are `qs`'s business, not ours: it defaults
# QS_CONFIG_NAME, so this lands on the same instance a bare `qs` would start.
# Set QS_CONFIG_NAME to talk to a different one.
#
# ponytail: one extra bash exec per keypress on skhd's repeat path. It is noise
# next to spawning the Qt binary that actually makes the call; inline the env
# here only if that ever stops being true.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec "$HERE/qs" ipc call "$@"

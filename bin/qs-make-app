#!/bin/bash
# Generate ~/Applications/Files.app, the Spotlight-launchable wrapper around
# bin/qs-finder.
#
# The bundle is generated rather than committed because its launcher has to name
# this repo by absolute path -- same reason karabiner.json and skhdrc do. Moving
# the repo means running this again.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
APP="${1:-$HOME/Applications/Files.app}"

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Files</string>
    <key>CFBundleDisplayName</key><string>Files</string>
    <key>CFBundleIdentifier</key><string>org.quickshell.files</string>
    <key>CFBundleExecutable</key><string>Files</string>
    <key>CFBundleIconFile</key><string>Files</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSMinimumSystemVersion</key><string>12.0</string>
</dict>
</plist>
PLIST

# exec, not a plain call: the bundle's process becomes quickshell, so the app
# stays alive as long as the window does instead of exiting immediately and
# leaving an orphan behind it.
cat > "$APP/Contents/MacOS/Files" <<LAUNCHER
#!/bin/bash
exec "$ROOT/bin/qs-finder" "\$@"
LAUNCHER
chmod +x "$APP/Contents/MacOS/Files"

if [ -f "$ROOT/assets/Files.icns" ]; then
    cp "$ROOT/assets/Files.icns" "$APP/Contents/Resources/Files.icns"
fi

# Ad-hoc sign the bundle. Nothing here is distributed, but an unsigned bundle is
# a coin flip on Apple Silicon and this repo already re-signs after every copy.
codesign -f -s - "$APP" >/dev/null 2>&1 || true

# LaunchServices caches bundles by path; without this a regenerated app can keep
# answering Spotlight with the previous copy's metadata.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
    -f "$APP" >/dev/null 2>&1 || true
touch "$APP"

# The launcher does not use Spotlight -- it finds apps through XDG desktop
# entries, which qs-index-apps generates from the Applications folders. Without
# this the app is launchable from Spotlight but invisible to the shell's own
# search, which is the one actually bound to a key here.
"$HERE/qs-index-apps" >/dev/null 2>&1 || true

# Login agent. Opening Files means starting a Qt process, and ~1.5s of that is
# engine and scene graph setup that cannot be optimised away -- so start it once
# at login with no window, and every real open is a warm show() instead.
AGENT="$HOME/Library/LaunchAgents/org.quickshell.files.plist"
mkdir -p "$(dirname "$AGENT")"
cat > "$AGENT" <<AGENTPLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>org.quickshell.files</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>-W</string>
        <string>-a</string>
        <string>$APP</string>
        <string>--args</string>
        <string>--hidden</string>
    </array>
    <key>RunAtLoad</key><true/>
    <!-- -W above makes open(1) block until the app exits, so this job's lifetime
         tracks the real process and KeepAlive can do its job. Without it launchd
         sees open(1) return immediately and relaunches forever.

         KeepAlive matters because the process does die on its own: quickshell
         exits when the config tree it is rooted in changes, and ~/.config is a
         git repo that gets pulled into. Every death meant the next open paid a
         3s cold start. It comes back hidden, so a restart costs nothing visible. -->
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
AGENTPLIST

launchctl bootout "gui/$UID/org.quickshell.files" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$UID" "$AGENT" >/dev/null 2>&1 || true

echo "built $APP"
echo "login agent: $AGENT  (remove with: launchctl bootout gui/$UID/org.quickshell.files && rm '$AGENT')"

#!/bin/bash
# Switch between the two bars. They draw in the same strip, so exactly one
# should run at a time.
#
#   qs-switch end4         end-4's illogical-impulse, adapted for macOS. It is
#                          the only quickshell config now, and it lives in
#                          ~/.config/quickshell like every other config.
#   qs-switch sketchybar   back to SketchyBar
#   qs-switch status
#
# The skhd bindings (ctrl+alt+cmd + i/tab/space/a/s/...) drive end-4, so they
# only do anything while quickshell is the running bar.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOG="${TMPDIR:-/tmp}/quickshell.log"

# skhd and launchd hand down a minimal PATH (launchctl getenv PATH is empty), so
# without this the shell cannot find yabai, jq, media-control or SwitchAudioSource.
# $ROOT/bin first: it carries our notify-send / xdg-open / pidof / qs stand-ins,
# which end-4 shells out to by bare name. Keeping them here rather than
# symlinked into /opt/homebrew means nothing is installed system-wide.
export PATH="$ROOT/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/quickshell-$UID}"
mkdir -p "$XDG_RUNTIME_DIR"
export QML2_IMPORT_PATH="$ROOT/shims${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"

# TCC grants Full Disk Access to the application responsible for the process
# tree, which the notification bridge needs and cannot look up for itself: it
# gets backgrounded and reparented to launchd before it can ask. Record who
# launched us while the answer is still here, so it can name the right binary.
export QS_RESPONSIBLE="$(ps -o comm= -p "$PPID" 2>/dev/null | tail -1)"

running() { pgrep -x "$1" >/dev/null 2>&1; }

# Other applications' notifications reach the shell only through the bridge --
# macOS has no notification-server protocol quickshell can claim, so it polls
# Notification Center instead (see bin/qs-notify-bridge). The bridge locks
# itself against duplicates and exits on its own once the shell is gone, so
# these two only have to be prompt, not careful.
BRIDGE_LOG="${TMPDIR:-/tmp}/qs-notify-bridge.log"

start_bridge() {
    nohup "$ROOT/bin/qs-notify-bridge" >>"$BRIDGE_LOG" 2>&1 &
    disown
}

stop_bridge() {
    pkill -f "bin/qs-notify-bridge" 2>/dev/null
}

stop_quickshell() {
    stop_bridge
    if running quickshell; then
        pkill -x quickshell
        sleep 1
        echo "quickshell: stopped"
    fi
}

stop_sketchybar() {
    if running sketchybar; then
        # `brew services stop` exits 0 even when it is not the thing managing
        # the process, so always follow up with a kill and confirm.
        brew services stop sketchybar >/dev/null 2>&1
        pkill -x sketchybar 2>/dev/null
        # sketchybar's helper scripts are long-lived children that outlive it and
        # get reparented to launchd, so killing only the bar leaves them polling
        # forever against a bar that is gone.
        pkill -f "$HOME/.config/sketchybar/helpers/" 2>/dev/null
        sleep 1
        running sketchybar && echo "sketchybar: FAILED to stop" >&2 || echo "sketchybar: stopped"
    fi
}

# yabai reserves space for whichever bar is running, and the two bars are not the
# same height. Leaving sketchybar's reservation in place under quickshell leaves a
# strip of desktop -- and the desktop icons sitting in it -- visible between the
# bar and the windows below. The end-4 bar is Appearance.sizes.baseBarHeight tall;
# services/YabaiBarSpace.qml then pads it by SIDE_PADDING like every other edge.
QS_BAR_HEIGHT=40
SB_BAR_HEIGHT=46
SB_TOP_PADDING=8

# The side paddings are reset too: end-4's bar can be vertical, and the shell
# expresses that as left_padding/right_padding (external_bar has no left/right).
# Without this, switching away from a vertical bar would leave a 46px strip of
# dead space reserved on that edge forever.
SIDE_PADDING=8

set_bar_padding() {   # $1 = reserved height, $2 = top padding
    command -v yabai >/dev/null 2>&1 || return 0
    yabai -m config external_bar "all:$1:0" >/dev/null 2>&1
    yabai -m config top_padding "$2" >/dev/null 2>&1
    yabai -m config bottom_padding "$SIDE_PADDING" >/dev/null 2>&1
    yabai -m config left_padding "$SIDE_PADDING" >/dev/null 2>&1
    yabai -m config right_padding "$SIDE_PADDING" >/dev/null 2>&1
}

# Shell surfaces are overlays, and the settings window is a dialog: neither
# belongs in the tiling layout. The label makes this idempotent -- yabai replaces
# a rule of the same label rather than stacking another copy on every switch.
float_quickshell_windows() {
    command -v yabai >/dev/null 2>&1 || return 0
    yabai -m rule --add label=quickshell app="^quickshell$" manage=off >/dev/null 2>&1
}

start_shell() {   # $1 = config path, $2 = label
    nohup "$ROOT/bin/quickshell" -p "$1" >"$LOG" 2>&1 &
    disown
    sleep 3
    if running quickshell; then
        echo "$2: started"
    else
        echo "$2: failed to start — see $LOG" >&2
        return 1
    fi
}

case "${1:-status}" in
    # `mine`/`qs` named the second bar, which is gone. They still land here so
    # anything that learned those names keeps working.
    end4|ii|qs|quickshell|mine)
        stop_sketchybar
        stop_quickshell
        # Only an initial guess for the common top-bar case, so the desktop is
        # not left holding sketchybar's reservation for the three seconds the
        # shell takes to come up. services/YabaiBarSpace.qml then takes over and
        # sets whatever the bar's actual position calls for, and keeps it in
        # step from then on -- so the two never disagree for longer than that.
        set_bar_padding "$QS_BAR_HEIGHT" "$SIDE_PADDING"
        float_quickshell_windows
        start_shell "$HOME/.config/quickshell/shell.qml" "end-4" && start_bridge
        ;;
    sketchybar|sb)
        stop_quickshell
        set_bar_padding "$SB_BAR_HEIGHT" "$SB_TOP_PADDING"
        running sketchybar || {
            brew services start sketchybar >/dev/null 2>&1 || (sketchybar >/dev/null 2>&1 &)
            echo "sketchybar: started"
        }
        ;;
    status)
        if running quickshell; then
            echo "quickshell: running (end-4)"
        else
            echo "quickshell: stopped"
        fi
        running sketchybar && echo "sketchybar: running" || echo "sketchybar: stopped"
        pgrep -f "bin/qs-notify-bridge" >/dev/null 2>&1 \
            && echo "notification bridge: running" \
            || echo "notification bridge: stopped"
        ;;
    *)
        echo "usage: qs-switch [end4|sketchybar|status]" >&2
        exit 2
        ;;
esac

#!/bin/bash
# Fast edit -> run loop for the Cocoa backend.
#
# Replaces the hand-rolled sequence that was costing a few minutes per attempt:
# build, copy, re-sign, kill, restart, sleep a guessed 20+ seconds, grep the log.
# The sleep was most of it -- this polls for readiness instead, so a QML-only
# change costs a couple of seconds and a C++ change costs the compile.
#
#   qs-dev              rebuild if sources changed, reinstall, restart the shell
#   qs-dev --no-build   just restart the shell (QML edits need nothing else)
#   qs-dev --probe      restart, then run the hover probe
#
# QML under ~/.config/quickshell and shims/ is read at startup, so a restart
# picks it up; there is nothing to build for those.

set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="${QS_SRC:-$ROOT}"
CONFIG="${QS_CONFIG:-$HOME/.config/quickshell/${QS_CONFIG_NAME:-end4}/shell.qml}"
LOG=/tmp/qs-dev.log

# Only PATH, for cmake and codesign below. XDG_RUNTIME_DIR and QML2_IMPORT_PATH
# belong to `qs`, which every launch here goes through.
export PATH="$ROOT/bin:/opt/homebrew/bin:$PATH"

started=$(date +%s)
step() { printf '  %-22s %ss\n' "$1" "$(( $(date +%s) - started ))"; }

if [ "${1:-}" != "--no-build" ]; then
    if ! cmake --build "$SRC/build" -j8 > /tmp/qs-dev-build.log 2>&1; then
        echo "BUILD FAILED:" >&2
        grep -E 'error|Error' /tmp/qs-dev-build.log | head -20 >&2
        exit 1
    fi
    step "built"

    # Into Quickshell.app, re-signed, staged so a running shell is never left
    # half-written -- see bin/qs-bundle.
    "$ROOT/bin/qs-bundle" "$SRC/build/src/quickshell" >/dev/null
    step "installed + signed"
fi

# Match the full path: every config's entry point is called shell.qml, so a
# basename match would take out the other config's instance too.
pkill -f "$CONFIG" 2>/dev/null
sleep 1
# The shell just killed leaves its media-control perl helper behind and its
# runtime dir on disk; every restart adds one of each (see qs-reap).
"$ROOT/bin/qs-reap" --quiet
nohup "$ROOT/bin/qs" -p "$CONFIG" > "$LOG" 2>&1 &
disown

# Poll for readiness rather than sleeping a fixed guess.
ready=0
for _ in $(seq 1 120); do
    if grep -q 'Configuration Loaded' "$LOG" 2>/dev/null; then ready=1; break; fi
    pgrep -f "$CONFIG" >/dev/null || break
    sleep 0.25
done

if [ "$ready" -eq 1 ]; then step "shell loaded"
else echo "  shell did NOT load — see $LOG" >&2; tail -5 "$LOG" >&2; exit 1; fi

# grep -c exits 1 on zero matches, so `|| echo 0` would append a second line.
# The launchers start the notification bridge; without this a session that only
# ever uses qs-dev silently has no bridge and macOS notifications go nowhere. The
# bridge holds an flock, so calling this when one is already up is a no-op.
if [ -x "$ROOT/bin/qs-notify-bridge" ]; then
    nohup "$ROOT/bin/qs-notify-bridge" >/dev/null 2>&1 &
    disown
fi

errs=$(grep -c 'ERROR' "$LOG" 2>/dev/null | head -1)
errs=${errs:-0}
echo "  errors: $errs"
[ "$errs" -eq 0 ] || grep 'ERROR' "$LOG" | head -5

[ "${1:-}" = "--probe" ] && "$ROOT/bin/qs-probe"
exit 0

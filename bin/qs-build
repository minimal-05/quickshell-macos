#!/bin/bash
# Build Quickshell for macOS from this checkout.
#
#   qs-build              build into ./build and install into Quickshell.app
#   qs-build --clean      discard the build directory first
#
# QS_CODESIGN_IDENTITY="Quickshell Dev" signs the bundle with that certificate
# so TCC grants survive rebuilds (PLATFORM.md, "TCC identity"); unset = ad-hoc.
#
# The Cocoa backend lives in src/cocoa/ in this repo. Edit it and re-run.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD="$ROOT/build"

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

[ "${1:-}" = "--clean" ] && { echo "==> removing $BUILD"; rm -rf "$BUILD"; }

for tool in cmake ninja git python3; do
    command -v "$tool" >/dev/null || { echo "missing: $tool" >&2; exit 1; }
done

echo "==> configuring"
# The Linux-only subsystems default off on Apple, so no -D flags are needed.
cmake -B "$BUILD" -S "$ROOT" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_PREFIX_PATH=/opt/homebrew \
    -DDISTRIBUTOR="quickshell-macos" >/dev/null

echo "==> building"
cmake --build "$BUILD" -j"$(sysctl -n hw.ncpu)"

# The binary lives in Quickshell.app so TCC grants key on a stable bundle id
# instead of a per-build cdhash; bin/quickshell becomes a wrapper onto it.
# qs-bundle copies, signs (QS_CODESIGN_IDENTITY, else ad-hoc) and writes the
# wrapper. See "TCC identity" in PLATFORM.md.
"$ROOT/bin/qs-bundle" "$BUILD/src/quickshell"

"$ROOT/bin/quickshell" --version

#!/bin/bash
# secret-tool(1) stand-in for the macOS port, on top of the login keychain.
#
#   secret-tool store  --label=<label> <attr> <value>...   secret read from stdin
#   secret-tool lookup <attr> <value>...                   prints the secret
#   secret-tool clear  <attr> <value>...
#   secret-tool --help
#
# libsecret addresses an item by attribute pairs; the keychain by service
# name. The pairs are joined into one service string ("application=illogical-
# impulse"), the label becomes the item name, the account is $USER.
# KeyringStorage.qml stores one JSON blob this way and try_lookup.sh reads it
# back; both are unchanged.
set -uo pipefail

verb="${1:-}"
shift || true
label=""
[ "$verb" = "--help" ] || [ "$verb" = "-h" ] || [ -z "$verb" ] && { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }
if [[ "${1:-}" == --label=* ]]; then label="${1#--label=}"; shift; fi
if [ "${1:-}" = "--label" ]; then label="$2"; shift 2; fi

svc=""
while [ $# -ge 2 ]; do
    svc+="${svc:+ }$1=$2"
    shift 2
done
[ -n "$svc" ] || { echo "secret-tool: need attribute value pairs" >&2; exit 2; }

case "$verb" in
    store)
        secret="$(cat)"
        security add-generic-password -U -a "$USER" -s "$svc" -l "${label:-$svc}" -w "$secret" ;;
    lookup)
        security find-generic-password -a "$USER" -s "$svc" -w 2>/dev/null ;;
    clear)
        security delete-generic-password -a "$USER" -s "$svc" >/dev/null 2>&1 ;;
    *)
        echo "secret-tool: '$verb' is not supported on macOS" >&2; exit 1 ;;
esac

#!/bin/bash
# Launch the macOS Quickshell shell.
#
# Two things quickshell needs on macOS that it gets for free on Linux:
#   XDG_RUNTIME_DIR   - the Linux default is /run/user/$UID, which does not
#                       exist here; without it quickshell segfaults on startup.
#   QML2_IMPORT_PATH  - where the compatibility shims for Linux-only Quickshell
#                       modules live, so configs importing them resolve.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"

# skhd and launchd hand down a minimal PATH (launchctl getenv PATH is empty), so
# without this the shell cannot find yabai, jq, media-control or SwitchAudioSource.
# $ROOT/bin first: it carries our notify-send / xdg-open / pidof / qs stand-ins,
# which end-4 shells out to by bare name. Keeping them here rather than
# symlinked into /opt/homebrew means nothing is installed system-wide.
export PATH="$ROOT/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/quickshell-$UID}"
mkdir -p "$XDG_RUNTIME_DIR"

if [ -d "$HERE/../shims" ]; then
    export QML2_IMPORT_PATH="$HERE/../shims${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
fi

# Other applications' notifications reach the shell only through the bridge:
# macOS has no notification-server protocol quickshell can claim, so it polls
# Notification Center instead (see qs-notify-bridge). QS_RESPONSIBLE is who
# launched us, which is the binary that has to hold Full Disk Access -- the
# bridge is backgrounded and reparented to launchd before it could look itself.
# It waits for the shell to appear, locks itself against duplicates, and exits
# once the shell is gone, so exec'ing over this script leaves no orphan.
# Previous instances leave orphan mediaremote-adapter.pl helpers and dead
# runtime dirs behind (see qs-reap); a fresh start is the moment to clear them.
"$HERE/qs-reap" --quiet

export QS_RESPONSIBLE="$(ps -o comm= -p "$PPID" 2>/dev/null | tail -1)"
nohup "$HERE/qs-notify-bridge" >>"${TMPDIR:-/tmp}/qs-notify-bridge.log" 2>&1 &
disown

# Exec the bundle binary by its real path so NSBundle.mainBundle is
# Quickshell.app and every subprocess (screencapture, osascript, python3)
# reports the bundle as the program asking TCC. Falls back to bin/quickshell
# for a tree that was built before the bundle existed.
# ponytail: the *responsible process* macOS records is still inherited from
# whoever exec'd this script (a terminal, skhd) unless the launcher disclaims
# it; the ceiling is "grants belong to the bundle when launched by launchd or
# `open -a Quickshell.app`", the upgrade path is a launchd agent that runs the
# bundle binary directly, or a tiny disclaiming spawner.
QS_EXE="$ROOT/Quickshell.app/Contents/MacOS/quickshell"
[ -x "$QS_EXE" ] || QS_EXE="$HERE/quickshell"
exec "$QS_EXE" "$@"

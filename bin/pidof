#!/bin/bash
# pidof(1) for macOS, which has no such command. BSD pgrep takes a regex, not a
# list of names, so each argument is matched exactly and the pids joined on one
# line the way pidof prints them.
set -uo pipefail
pids=""
for name in "$@"; do
    found=$(pgrep -x "$name" 2>/dev/null | tr '\n' ' ')
    pids+="$found"
done
pids="$(printf '%s' "$pids" | xargs 2>/dev/null || true)"
[ -n "$pids" ] || exit 1
printf '%s\n' "$pids"

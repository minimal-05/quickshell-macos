#!/usr/bin/env python3
"""Forward real macOS notifications into the shell's own popup and list.

macOS has no notification-server protocol a third party can claim, so quickshell
cannot be the notification daemon it is on Linux (see shims/Quickshell/Services/
Notifications/NotificationServer.qml -- it only ever sees what the shell itself
raises). The one place another application's notification is visible is the
Notification Center store usernoted keeps at

    ~/Library/Group Containers/group.com.apple.usernoted/db2/db

so this polls that store -- there is no API to subscribe to it -- and replays
each new row through notify-send, which hands it to the running shell over IPC,
the stand-in for the session bus.

Started and stopped with the shell by qs-start; running it by hand
is only useful for debugging. It holds a lock so a second copy exits at once,
and it exits by itself once the shell has been gone for SHELL_GRACE seconds, so
neither a restart nor a crash can leave an orphan polling forever.

The store is protected by TCC's Full Disk Access, which is granted to the
application *responsible* for the process tree -- the terminal or launcher the
shell was started from -- and never to this script. Started from Terminal.app or
kitty it inherits their grant; started from skhd or a login item it may have
none, and every read fails with "unable to open database file". Nothing here can
prompt for or work around that, so it is reported once, by name, and the bridge
gives up rather than spinning silently.
"""

import fcntl
import json
import os
import plistlib
import sqlite3
import subprocess
import sys
import time

DB = os.path.expanduser(
    "~/Library/Group Containers/group.com.apple.usernoted/db2/db"
)
NOTIFY_SEND = os.path.join(os.path.dirname(os.path.abspath(__file__)), "notify-send")

STATE_DIR = os.path.expanduser("~/Library/Caches/quickshell")
LOCK_PATH = os.path.join(STATE_DIR, "notify-bridge.lock")
STATE_PATH = os.path.join(STATE_DIR, "notify-bridge.json")

INTERVAL = 2.0
# Notification uuids remembered on disk, so a restart cannot replay what the
# previous run already forwarded.
SEEN_LIMIT = 300
# qs-dev stops and restarts the shell in place; don't quit over that
# gap, only over a shell that is really gone.
SHELL_GRACE = 20.0
# How long reads may keep failing before that counts as lost access rather than
# usernoted swapping the store out underneath us.
ACCESS_GRACE = 60.0

# notify-send falls back to `osascript display notification` when no shell is
# running, and those land back in this same store under Script Editor's bundle.
# Forwarding them would loop.
SKIP_BUNDLES = {"com.apple.scripteditor2"}


def connect():
    return sqlite3.connect(f"file:{DB}?mode=ro", uri=True)


def claim_lock():
    """Single instance. Returns the fd, which must stay open for the process
    lifetime -- closing it releases the lock."""
    os.makedirs(STATE_DIR, exist_ok=True)
    fd = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, f"{os.getpid()}\n".encode())
    return fd


def load_state():
    try:
        with open(STATE_PATH) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    if not isinstance(state.get("seen"), list):
        state["seen"] = []
    return state


def save_state(state):
    state["seen"] = state["seen"][-SEEN_LIMIT:]
    tmp = f"{STATE_PATH}.new"
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, STATE_PATH)
    except OSError:
        pass


def shell_running():
    return subprocess.run(
        ["pgrep", "-x", "quickshell"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0


def text(value):
    """Flatten what usernoted actually stores. A field is not always a string:
    localised ones arrive as the triple [key, key, format-args] -- an App Store
    update alert and a Focus change (['OFF', 'OFF', []]) both do -- and handing
    one of those straight to subprocess took the whole bridge down. The key is
    element 0 and its format arguments element 2. Keys whose strings live in a
    private framework rather than in the app bundle cannot be resolved from
    here, so the popup shows the key rather than inventing text for it."""
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    if isinstance(value, (list, tuple)):
        if len(value) == 3 and isinstance(value[2], (list, tuple)):
            return substitute(text(value[0]), value[2])
        parts = []
        for part in (text(v) for v in value):
            if part and part not in parts:
                parts.append(part)
        return " ".join(parts)
    return str(value)


def substitute(template, args):
    """Fill a localised format's placeholders -- "%@ sent you a message"."""
    for index, arg in enumerate(args, 1):
        template = template.replace(f"%{index}$@", text(arg))
    for arg in args:
        template = template.replace("%@", text(arg), 1)
    return template


_app_names = {}


def app_name(bundle):
    """LaunchServices' display name, so the popup says "Messages" rather than
    the bundle's last component, "MobileSMS". Cached: mdfind is far too slow to
    run per notification."""
    if bundle not in _app_names:
        name = ""
        # The id comes out of the store, so keep it out of the query language.
        if bundle and all(c.isalnum() or c in "-._" for c in bundle):
            try:
                out = subprocess.run(
                    ["mdfind", f"kMDItemCFBundleIdentifier == '{bundle}'"],
                    capture_output=True, text=True, timeout=5,
                ).stdout.splitlines()
                for path in out:
                    if path.endswith(".app"):
                        name = os.path.basename(path)[:-4]
                        break
            except (OSError, subprocess.SubprocessError):
                pass
        _app_names[bundle] = name or bundle.rsplit(".", 1)[-1] or bundle
    return _app_names[bundle]


def forward(blob):
    try:
        record = plistlib.loads(blob)
    except Exception:
        return False
    bundle = text(record.get("app"))
    if bundle.lower() in SKIP_BUNDLES:
        return False
    req = record.get("req") or {}
    title = text(req.get("titl"))
    subtitle = text(req.get("subt"))
    body = text(req.get("body"))
    if not title and not body:
        return False
    if subtitle and subtitle not in body:
        body = f"{subtitle}\n{body}" if body else subtitle

    # The bundle id doubles as the icon name: the macOS icon provider resolves
    # bundle ids through LaunchServices (src/cocoa/appicon.mm).
    subprocess.run(
        [NOTIFY_SEND, title, body, "-a", app_name(bundle), "-i", bundle],
        check=False,
    )
    return True


def responsible_app():
    """Which binary the user has to grant Full Disk Access to. The launchers
    export QS_RESPONSIBLE because they can still see it: the bridge is
    backgrounded and reparented to launchd, which erases its own ancestry."""
    name = os.path.basename(os.environ.get("QS_RESPONSIBLE", "").strip())
    if not name or name == "launchd":
        return "the terminal or launcher you start the shell from"
    return name


def report_no_access(state, err):
    """Full Disk Access cannot be prompted for or worked around from here, so
    say what to grant and to which binary -- once. Repeating it on every shell
    start would be worse than the silence it replaces."""
    print(f"cannot read {DB}: {err}", file=sys.stderr)
    responsible = responsible_app()
    if state.get("fda_warned") != responsible:
        subprocess.run(
            [
                NOTIFY_SEND,
                "Notifications need Full Disk Access",
                f"Can't read Notification Center, so only this shell's own "
                f"notifications will appear. Grant Full Disk Access to "
                f"{responsible} in System Settings > Privacy & Security, then "
                f"restart the shell.",
                "-a", "Quickshell",
                "-u", "critical",
            ],
            check=False,
        )
        state["fda_warned"] = responsible
        save_state(state)
    return 1


def main():
    if claim_lock() is None:
        return 0  # another bridge already has it

    # Started alongside the shell, so give it a moment to come up; with no shell
    # to deliver to there is nothing to do.
    deadline = time.monotonic() + SHELL_GRACE
    while not shell_running():
        if time.monotonic() > deadline:
            return 0
        time.sleep(0.5)

    state = load_state()
    try:
        db = connect()
        last = db.execute("select coalesce(max(rec_id), 0) from record").fetchone()[0]
    except sqlite3.Error as err:
        return report_no_access(state, err)

    # Start from the newest row: the backlog in the store has already been shown
    # by Notification Center, and replaying it on every shell start would bury
    # the user.
    print(f"watching Notification Center from record {last}", file=sys.stderr)
    seen = state["seen"]
    gone_since = None
    failing_since = None

    while True:
        time.sleep(INTERVAL)

        if shell_running():
            gone_since = None
        elif gone_since is None:
            gone_since = time.monotonic()
            continue
        elif time.monotonic() - gone_since > SHELL_GRACE:
            return 0  # the shell is really gone, not restarting
        else:
            continue

        try:
            rows = db.execute(
                "select rec_id, uuid, data from record where rec_id > ? order by rec_id",
                (last,),
            ).fetchall()
            failing_since = None
        except sqlite3.Error as err:
            # usernoted rewrites the store from time to time; reopen and carry
            # on. Reads that keep failing mean access is gone, not a rewrite.
            if failing_since is None:
                failing_since = time.monotonic()
            try:
                db = connect()
                # A rewritten store restarts rec_id, so a stale high-water mark
                # would silence the bridge for good.
                last = min(last, db.execute(
                    "select coalesce(max(rec_id), 0) from record").fetchone()[0])
                failing_since = None
            except sqlite3.Error:
                if time.monotonic() - failing_since > ACCESS_GRACE:
                    return report_no_access(state, err)
            continue

        forwarded = False
        for rec_id, uuid, blob in rows:
            last = rec_id
            key = uuid.hex() if isinstance(uuid, bytes) else str(uuid)
            if not blob or key in seen:
                continue
            if forward(blob):
                seen.append(key)
                forwarded = True
        if forwarded:
            save_state(state)
            seen = state["seen"]


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        pass

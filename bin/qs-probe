#!/bin/bash
# Drive the hover probe and print a pass/fail table.
#
# Answers, deterministically and in a few seconds, the question screenshots kept
# getting wrong: does a shell panel actually see the pointer enter and leave?
#
#   qs-probe            run the standard enter/leave sequence
#   qs-probe --keep     leave the probe running afterwards

set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT/bin:/opt/homebrew/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/quickshell-$UID}"
export QML2_IMPORT_PATH="$ROOT/shims"
mkdir -p "$XDG_RUNTIME_DIR"

WARP="$ROOT/bin/warp.py"
LOG=/tmp/qs-probe.log

PROBE_QML="${QS_PROBE_QML:-$ROOT/tests/hoverprobe.qml}"
PROBE_PAT="$(basename "$PROBE_QML")"
pkill -f "$PROBE_PAT" 2>/dev/null
sleep 1
nohup "$ROOT/bin/quickshell" -p "$PROBE_QML" > "$LOG" 2>&1 &
disown

# Poll for readiness instead of sleeping a fixed amount.
for _ in $(seq 1 60); do
    grep -q 'Configuration Loaded' "$LOG" 2>/dev/null && break
    sleep 0.5
done
PID="$(pgrep -f "$PROBE_PAT" | head -1)"
[ -n "$PID" ] || { echo "probe failed to start; see $LOG" >&2; exit 1; }

ask() { "$ROOT/bin/quickshell" ipc --pid "$PID" call probe "$1" 2>/dev/null | tr -d '\r\n'; }
move() { /usr/bin/python3 "$WARP" "$1" "$2" >/dev/null 2>&1; sleep 0.6; }

pass=0; fail=0
check() {  # $1 = label, $2 = expected, $3 = actual
    if [ "$2" = "$3" ]; then printf '  PASS  %-34s %s\n' "$1" "$3"; pass=$((pass+1))
    else printf '  FAIL  %-34s got %-9s want %s\n' "$1" "$3" "$2"; fail=$((fail+1)); fi
}

if [ "${1:-}" = "--watch" ]; then
    # Hover is the one thing synthetic input cannot exercise: CGEvent moves do
    # relocate the cursor and do drive yabai, but they never reach an inactive
    # accessory process's window, so Qt's hover never fires (verified: enter=0
    # for both borderless and focusable panels). Real input is the only way, so
    # make asking the human cheap: a green strip appears at the top of the
    # screen; sweep the pointer on and off it.
    secs="${2:-15}"
    echo "  Move the pointer onto the green strip at the top, then off it."
    echo "  Watching for ${secs}s..."
    ask reset >/dev/null
    end=$(( $(date +%s) + secs ))
    last=""
    while [ "$(date +%s)" -lt "$end" ]; do
        now="$(ask hover) $(ask events)"
        [ "$now" != "$last" ] && { printf '   %s\n' "$now"; last="$now"; }
        sleep 0.25
    done
    echo "  final: $(ask events)"
    pkill -f "$PROBE_PAT" 2>/dev/null
    exit 0
fi

ask reset >/dev/null
move 840 600; check "pointer off panel"        outside "$(ask hover)"
move 400 20;  check "pointer on panel"         inside  "$(ask hover)"
move 840 600; check "pointer moved to a window" outside "$(ask hover)"
move 400 20;  check "back on panel"            inside  "$(ask hover)"
move 1500 900; check "far corner"              outside "$(ask hover)"

echo "  events: $(ask events)"
echo "  $pass passed, $fail failed"

[ "${1:-}" = "--keep" ] || pkill -f "$PROBE_PAT" 2>/dev/null
exit $([ "$fail" -eq 0 ] && echo 0 || echo 1)
